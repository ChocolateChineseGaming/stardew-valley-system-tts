<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SystemVoice</AssemblyName>
    <RootNamespace>MandarinVoice</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseSharedCompilation>false</UseSharedCompilation>
    <GamePath Condition="'$(GamePath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Stardew Valley/Contents/MacOS</GamePath>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="StardewModdingAPI"><HintPath>$(GamePath)/StardewModdingAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Stardew Valley"><HintPath>$(GamePath)/Stardew Valley.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(GamePath)/MonoGame.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="xTile"><HintPath>$(GamePath)/xTile.dll</HintPath><Private>false</Private></Reference>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="audio/**/*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveReferences" Condition="!Exists('$(GamePath)/StardewModdingAPI.dll')">
    <Error Text="找不到 SMAPI；请使用 -p:GamePath=游戏 Contents/MacOS 的完整路径。" />
  </Target>
</Project>
